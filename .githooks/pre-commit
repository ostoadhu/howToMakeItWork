#!/bin/sh
# Regenerates the_app_AI state machine diagram when its sources are committed.
# Enable once per clone:  git config core.hooksPath .githooks

changed=$(git diff --cached --name-only -- \
    the_app_AI/docs/state_machine.yaml \
    the_app_AI/docs/use_cases.md \
    the_app_AI/tools/gen_state_diagram.py)
[ -z "$changed" ] && exit 0

for py in python3 python; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c "import yaml" >/dev/null 2>&1; then
        "$py" the_app_AI/tools/gen_state_diagram.py || {
            echo "pre-commit: fix the_app_AI/docs/state_machine.yaml / use_cases.md and commit again" >&2
            exit 1
        }
        git add the_app_AI/docs/use_cases.md
        exit 0
    fi
done

echo "pre-commit: python with PyYAML not found; cannot regenerate the state machine diagram" >&2
echo "            install it (pip install pyyaml / apt install python3-yaml) or commit with --no-verify" >&2
exit 1
